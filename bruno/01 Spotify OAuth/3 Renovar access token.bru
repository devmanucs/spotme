meta {
  name: 3 Renovar access token
  type: http
  seq: 3
}

post {
  url: {{spotifyAccountsUrl}}/api/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: {{spotifyClientId}}
  password: {{spotifyClientSecret}}
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{spotifyRefreshToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("spotifyAccessToken", res.body.access_token);
    // O Spotify às vezes devolve um refresh token novo: o antigo deixa de valer.
    if (res.body.refresh_token) {
      bru.setEnvVar("spotifyRefreshToken", res.body.refresh_token);
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  Mesmo fluxo que o coletor faz a cada execução. Anote no Spike 0.1 se o refresh token vem rotacionado (impacta o Vault).
}
